{
  "name": "allure",
  "version": "3.33.0",
  "description": "Allure Commandline Tool",
  "keywords": [
    "allure",
    "report",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "bin": "./cli.js",
  "files": [
    "./dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./rules": "./dist/rules.js",
    "./qualityGate": "./dist/qualityGate.js"
  },
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json && run compile:process-host",
    "compile:process-host": "node ./scripts/compile-process-host.mjs",
    "clean": "rimraf ./dist",
    "start": "node ./cli.js",
    "test": "rimraf out && vp test run",
    "test:unit": "yarn test",
    "lint": "vp lint --import-plugin src test features stories",
    "lint:fix": "vp lint --import-plugin --fix src test features stories"
  },
  "dependencies": {
    "@allurereport/charts-api": "3.33.0",
    "@allurereport/ci": "3.33.0",
    "@allurereport/cli-commons": "3.33.0",
    "@allurereport/core": "3.33.0",
    "@allurereport/core-api": "3.33.0",
    "@allurereport/directory-watcher": "3.33.0",
    "@allurereport/plugin-agent": "3.33.0",
    "@allurereport/plugin-allure2": "3.33.0",
    "@allurereport/plugin-api": "3.33.0",
    "@allurereport/plugin-awesome": "3.33.0",
    "@allurereport/plugin-classic": "3.33.0",
    "@allurereport/plugin-csv": "3.33.0",
    "@allurereport/plugin-dashboard": "3.33.0",
    "@allurereport/plugin-jira": "3.33.0",
    "@allurereport/plugin-log": "3.33.0",
    "@allurereport/plugin-metrics": "3.33.0",
    "@allurereport/plugin-progress": "3.33.0",
    "@allurereport/plugin-server-reload": "3.33.0",
    "@allurereport/plugin-slack": "3.33.0",
    "@allurereport/plugin-xray": "3.33.0",
    "@allurereport/reader-api": "3.33.0",
    "@allurereport/service": "3.33.0",
    "@allurereport/static-server": "3.33.0",
    "adm-zip": "0.6.1",
    "clipanion": "^4.0.0-rc.4",
    "glob": "^13.0.6",
    "lodash.omit": "^4.18.0",
    "prompts": "^2.4.2",
    "typanion": "^3.14.0",
    "yoctocolors": "^2.2.0"
  },
  "devDependencies": {
    "@allurereport/common-config": "3.33.0",
    "@types/node": "^20.19.43",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^5.0.5",
    "allure-js-commons": "^3.14.0",
    "allure-vitest": "^3.14.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
    "vite-plus": "^1.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}